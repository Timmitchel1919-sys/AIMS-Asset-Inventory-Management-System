# Cloud Functions runtime parameters (firebase-functions/params).
# Copy to functions/.env (git-ignored) or functions/.env.aims-asset-inventory-system.

# Phase 3 — one-way export target. The id in a Sheets URL:
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
AIMS_SYNC_SPREADSHEET_ID=

# ANTHROPIC_API_KEY is a Secret, not a param — set it with:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
