{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "severity",
      "evidence",
      "verification_status"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "severity": {
        "enum": [
          "BLOCKER",
          "HIGH",
          "MEDIUM",
          "LOW",
          "INFO"
        ]
      },
      "evidence": {
        "type": "string"
      },
      "verification_status": {
        "enum": [
          "PASS",
          "FAIL",
          "NOT_RUN",
          "NOT_APPLICABLE"
        ]
      },
      "recommendation": {
        "type": "string"
      }
    }
  }
}
