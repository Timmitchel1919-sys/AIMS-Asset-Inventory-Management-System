# ==================================================
# AIMS - Asset & Inventory Management System
# Git Ignore Configuration
# ==================================================

# ------------------------------
# Dependencies
# ------------------------------
node_modules/
.pnpm-store/

# ------------------------------
# Build output
# ------------------------------
dist/
build/
.next/
out/

# ------------------------------
# Testing
# ------------------------------
coverage/
playwright-report/
test-results/

# ------------------------------
# TypeScript
# ------------------------------
*.tsbuildinfo

# ------------------------------
# Environment variables / secrets
# ------------------------------
.env
.env.*

# Keep example environment file
!.env.example

# ------------------------------
# Firebase
# ------------------------------
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# Firebase Admin / Service Account credentials
firebase-adminsdk*.json
serviceAccountKey.json
service-account*.json
serviceAccount*.json

# ------------------------------
# Logs
# ------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------
# IDE / Editor
# ------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

.idea/

# Visual Studio local metadata
.vs/

# Local AI assistant configuration
.claude/
.agents/
skills-lock.json

# ------------------------------
# Operating system files
# ------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------
# Temporary files
# ------------------------------
*.tmp
*.temp
*.swp
*.swo

# ------------------------------
# Local cache
# ------------------------------
.cache/
.parcel-cache/
.eslintcache

# ------------------------------
# Vercel
# ------------------------------
.vercel/

# ------------------------------
