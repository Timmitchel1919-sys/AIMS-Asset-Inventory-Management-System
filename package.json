{
  "name": "aims-asset-inventory-management-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --configLoader runner",
    "dev:presentation": "vite --mode presentation --config vite.config.ts --configLoader runner",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build --config vite.config.ts --configLoader runner",
    "build:presentation": "tsc -p tsconfig.app.json --noEmit && vite build --mode presentation --config vite.config.ts --configLoader runner",
    "preview:presentation": "vite preview --mode presentation --config vite.config.ts --configLoader runner",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:seed": "node scripts/demo-reset.mjs",
    "demo:validate": "vitest run src/data/demoData.test.ts --configLoader runner",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "test:auth-emulator": "node scripts/run-auth-emulator-smoke.mjs",
    "test:firestore-rules": "node scripts/run-firestore-rules.mjs",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.17.1",
    "i18next": "^25.6.0",
    "lucide-react": "^0.548.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.2.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.6",
    "rollup": "npm:@rollup/wasm-node@^4.62.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
