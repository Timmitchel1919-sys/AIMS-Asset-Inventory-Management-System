rules_version = '2';

// AIMS production prototype for the Standard edition `(default)` database.
// Client-created operational records carry immutable identity/business fields
// plus server timestamp audit metadata. Unknown collections default to deny.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function hasSchoolDomain() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@[Kk][Aa][Nn][Gg][Oo][Ee][Rr][Oo][Ee][Ss][Cc][Hh][Oo][Oo][Ll][.]com$');
    }
    function isVerified() {
      return hasSchoolDomain() && request.auth.token.email_verified == true;
    }
    function isBootstrapAdministrator() {
      return isVerified() && request.auth.uid == 'VogTjC6S1aXHO6ySBbdiQ7LNOYG3';
    }
    function accessAssignmentPath() {
      return /databases/$(database)/documents/accessAssignments/$(request.auth.uid);
    }
    function hasAccessAssignment() {
      return isVerified() && exists(accessAssignmentPath());
    }
    // A verified school account with an explicitly provisioned, active access
    // assignment. Missing assignments are not treated as implicit access.
    function isActiveAssignment() {
      return hasAccessAssignment() && get(accessAssignmentPath()).data.active == true;
    }
    function hasTrustedTokenSignal() {
      return (('role' in request.auth.token)
          && request.auth.token.role is string
          && request.auth.token.role.size() > 0)
        || (('permissions' in request.auth.token)
          && request.auth.token.permissions is list
          && request.auth.token.permissions.size() > 0);
    }
    function hasTrustedAccessSignal() {
      return isVerified()
        && ((hasTrustedTokenSignal() && !hasAccessAssignment())
          || isActiveAssignment());
    }
    // Central authorization accepts only verified users whose trusted token
    // or protected access-assignment proves that provisioning completed.
    function isAuthorizedAimsUser() {
      return isOwner() || hasTrustedAccessSignal();
    }
    // The single AIMS Owner / super admin, identified by the verified email
    // in the Firebase Auth token (which a client cannot forge or edit). It is
    // deliberately NOT derived from the writable accessAssignments.role field,
    // so no other user can promote themselves. The Owner is never locked out
    // by a suspension or denial. Keep in sync with AIMS_OWNER_EMAIL in
    // src/auth/accessBootstrap.ts.
    function isOwner() {
      return isVerified() && request.auth.token.email.lower() == 'aliendas@kangoeroeschool.com';
    }
    // Master Data (Hoofdlocaties, Codegroepen) may be viewed, created, updated
    // and restored by every authorized user. Archiving (recycle bin) and
    // deleting is NOT possible from a client at all: it runs only through the
    // archiveMasterData Cloud Function, which enforces the administrator
    // accounts (see MASTER_DATA_DELETE_EMAILS in functions/masterData.js and
    // src/auth/masterDataDeletion.ts) and checks real dependencies, which
    // Rules cannot query.
    // The 'owner' role label may only ever be written by the Owner.
    function ownerRoleAllowed(data) {
      return data.role != 'owner' || isOwner();
    }
    // Explicit denials override otherwise valid module access.
    function isExplicitlyDenied(value) {
      return (('denials' in request.auth.token) && request.auth.token.denials is list && value in request.auth.token.denials)
        || (hasAccessAssignment()
          && get(accessAssignmentPath()).data.denials is list
          && value in get(accessAssignmentPath()).data.denials);
    }
    // A trusted role, permission claim or active assignment activates the
    // existing broad AIMS user model; explicit denials still take precedence.
    function hasPermission(value) {
      return isOwner() || (hasTrustedAccessSignal() && !isExplicitlyDenied(value));
    }
    function hasAnyPermission(values) {
      return isOwner() || (hasTrustedAccessSignal() && values is list && values.size() <= 30 && !(
        (('denials' in request.auth.token) && request.auth.token.denials is list && request.auth.token.denials.hasAny(values))
        || (hasAccessAssignment() && get(accessAssignmentPath()).data.denials.hasAny(values))
      ));
    }
    function isOwnUser(uid) { return isSignedIn() && request.auth.uid == uid; }
    function shortString(data, field, maximum) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maximum);
    }
    function nullableShortString(data, field, maximum) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maximum);
    }
    function boundedList(data, field, maximum) {
      return !(field in data) || (data[field] is list && data[field].size() <= maximum);
    }
    function auditMetadataValid(data) {
      return data.updatedAt is timestamp
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && data.updatedBy.size() <= 128
        && (!("createdAt" in data) || data.createdAt is timestamp)
        && (!("createdBy" in data) || (data.createdBy is string && data.createdBy.size() <= 128));
    }
    function immutableAuditFields() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    function immutableUserCreatedAt() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }
    function noPrivilegeFields(data) {
      return !data.keys().hasAny(['role', 'roles', 'permissions', 'isAdmin', 'admin']);
    }
    function validLegacyInventorySourceData(data) {
      return !('sourceData' in data) || (
        data.sourceData is map
        && data.sourceData.keys().hasOnly([
          'inventoryCode','brandModel','specifications','serialNumber','user',
          'location','condition','loanContract','charger','laptopBag','mouse','purchase'
        ])
        && shortString(data.sourceData, 'inventoryCode', 80)
        && shortString(data.sourceData, 'brandModel', 300)
        && shortString(data.sourceData, 'specifications', 4000)
        && shortString(data.sourceData, 'serialNumber', 200)
        && shortString(data.sourceData, 'user', 300)
        && shortString(data.sourceData, 'location', 300)
        && shortString(data.sourceData, 'condition', 100)
        && shortString(data.sourceData, 'loanContract', 100)
        && shortString(data.sourceData, 'charger', 100)
        && shortString(data.sourceData, 'laptopBag', 100)
        && shortString(data.sourceData, 'mouse', 100)
        && shortString(data.sourceData, 'purchase', 100)
      );
    }
    function validLegacyInventoryImportMetadata(data) {
      return !('importMetadata' in data) || (
        data.importMetadata is map
        && data.importMetadata.keys().hasOnly([
          'source','sourceType','importedAt','importedBy',
          'sourceRecordCode','migrationVersion'
        ])
        && data.importMetadata.keys().hasAll([
          'source','sourceType','importedAt','importedBy',
          'sourceRecordCode','migrationVersion'
        ])
        && data.importMetadata.source == 'KCS Laptop Inventory'
        && data.importMetadata.sourceType == 'legacy_inventory'
        && data.importMetadata.importedAt is timestamp
        && data.importMetadata.importedBy is string
        && data.importMetadata.importedBy.size() > 0
        && data.importMetadata.importedBy.size() <= 150
        && data.importMetadata.sourceRecordCode is string
        && data.importMetadata.sourceRecordCode.size() > 0
        && data.importMetadata.sourceRecordCode.size() <= 80
        && data.importMetadata.migrationVersion == 'laptop-inventory-v1'
      );
    }
    function isAuthorizedLegacyInventoryImport(data) {
      return hasPermission('inventory.import')
        && ('sourceData' in data)
        && ('importMetadata' in data)
        && validLegacyInventorySourceData(data)
        && validLegacyInventoryImportMetadata(data);
    }
    function validLegacyImportedAsset(data) {
      return isAuthorizedLegacyInventoryImport(data)
        && data.keys().hasAll([
          'code','codePrefix','codeNumber','name','category','type','status',
          'condition','sourceData','importMetadata','createdAt','createdBy',
          'updatedAt','updatedBy'
        ])
        && data.code is string && data.code.size() > 0 && data.code.size() <= 40
        && data.codePrefix is string && data.codePrefix.size() > 0 && data.codePrefix.size() <= 16
        && data.codeNumber is int && data.codeNumber >= 1 && data.codeNumber <= 1000000000
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && auditMetadataValid(data) && noPrivilegeFields(data);
    }
    function validLegacyImportedInventory(data) {
      return isAuthorizedLegacyInventoryImport(data)
        && data.keys().hasAll([
          'code','name','itemType','category','unit','onHand','reserved',
          'sourceData','importMetadata','createdAt','createdBy','updatedAt','updatedBy'
        ])
        && data.code is string && data.code.size() > 0 && data.code.size() <= 80
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.onHand is number && data.onHand >= 0
        && data.reserved is number && data.reserved >= 0 && data.reserved <= data.onHand
        && auditMetadataValid(data) && noPrivilegeFields(data);
    }
    function validLegacyInventoryHistory(data) {
      return hasPermission('inventory.import')
        && data.source == 'legacy_import' && data.isLegacyImport == true
        && data.isManual == false && data.status == 'Final'
        && data.assetId is string && data.assetId.size() > 0 && data.assetId.size() <= 128
        && data.assetCode is string && data.assetCode.size() > 0 && data.assetCode.size() <= 40
        && data.eventType == 'inventory_import_created'
        && data.occurredAt is string && data.occurredAt.size() <= 40
        && auditMetadataValid(data) && noPrivilegeFields(data);
    }

    function validPreferences(preferences) {
      return preferences is map
        && preferences.keys().hasOnly([
          'theme','language','dateFormat','timeFormat','timezone',
          'firstDayOfWeek','notifications','fontFamily','fontSize'
        ])
        && (!('theme' in preferences) || preferences.theme in ['aimsAzureGlass','dark','aimsMidnight','aimsEmeraldGloss','aimsLight','aimsTurquoiseGlass'])
        && (!('language' in preferences) || preferences.language in ['en','nl'])
        && (!('dateFormat' in preferences) || preferences.dateFormat in ['DD-MM-YYYY','MM-DD-YYYY','YYYY-MM-DD'])
        && (!('timeFormat' in preferences) || preferences.timeFormat in ['24-hour','12-hour'])
        && (!('timezone' in preferences) || (preferences.timezone is string && preferences.timezone.size() <= 60))
        && (!('firstDayOfWeek' in preferences) || preferences.firstDayOfWeek in ['monday','sunday'])
        && (!('notifications' in preferences) || (preferences.notifications is map && preferences.notifications.size() <= 20))
        && (!('fontFamily' in preferences) || preferences.fontFamily in ['Inter','IBM Plex Mono','Montserrat','Source Sans 3','Roboto','Open Sans'])
        && (!('fontSize' in preferences) || (preferences.fontSize is int && preferences.fontSize >= 12 && preferences.fontSize <= 16));
    }

    function validUser(data) {
      return data.keys().hasOnly([
          'uid','displayName','email','emailNormalized','photoURL','department',
          'jobTitle','accountType','organizationDomain','authProvider',
          'emailVerified','status','createdAt','updatedAt','firstLoginAt',
          'lastLoginAt','preferences'
        ])
        && data.keys().hasAll([
          'uid','displayName','email','emailNormalized','accountType',
          'organizationDomain','authProvider','emailVerified','status',
          'createdAt','updatedAt','firstLoginAt','lastLoginAt','preferences'
        ])
        && data.uid is string && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email == request.auth.token.email
        && data.emailNormalized == data.email
        && nullableShortString(data, 'photoURL', 2048)
        && nullableShortString(data, 'department', 100)
        && nullableShortString(data, 'jobTitle', 100)
        && data.accountType == 'school-user'
        && data.organizationDomain == 'kangoeroeschool.com'
        && data.authProvider in ['password', 'google']
        && data.emailVerified == true
        && data.status == 'active'
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.firstLoginAt is timestamp && data.lastLoginAt is timestamp
        && data.preferences.size() <= 20 && validPreferences(data.preferences);
    }

    function validAsset(data) {
      return data.keys().hasOnly([
          'code','codePrefix','codeNumber','previousCodes','name','description',
          'category','subcategory','type','brand','model','serialNumber','barcode',
          'location','currentLocationId','homeLocationId','mainLocationId',
          'currentLocationPath','currentBin',
          'lastMovementAt','department','assignedTo','responsibleEmployee',
          'supplier','manufacturer','status','condition','purchaseDate',
          'purchasePrice','warrantyStart','warrantyExpiry','dateAdded','createdBy',
          'lastUpdated','lastModifiedBy','maintenanceRequired','usefulLifeEnd',
          'technicalSpecifications','remoteAccess','attachments','photos','notes',
          'sourceData','importMetadata','qr','qrToken','qrUpdatedAt',
          // Canonical references (additive; the text fields above stay).
          'categoryId','assetTypeId','codeGroupId','departmentId','assignedUserId',
          'createdAt','updatedAt','updatedBy','isArchived','archivedAt','archivedBy',
          'deletionReason','restoredAt','restoredBy'
        ])
        && data.keys().hasAll(['code','codePrefix','codeNumber','name','category','type','brand','model','serialNumber','location','department','status','condition','purchaseDate','warrantyExpiry','lastUpdated','qr','createdAt','createdBy','updatedAt','updatedBy'])
        && (!('deletionReason' in data) || (data.deletionReason is string && data.deletionReason.size() <= 500))
        && (!('restoredBy' in data) || (data.restoredBy is string && data.restoredBy.size() <= 150))
        && (!('restoredAt' in data) || data.restoredAt is string)
        && data.code is string && data.code.size() > 0 && data.code.size() <= 40
        && data.codePrefix is string && data.codePrefix.size() > 0 && data.codePrefix.size() <= 16
        && data.codeNumber is int && data.codeNumber >= 1 && data.codeNumber <= 1000000000
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.serialNumber is string && data.serialNumber.size() <= 200
        && shortString(data, 'description', 4000)
        && shortString(data, 'notes', 4000)
        && boundedList(data, 'previousCodes', 50)
        && boundedList(data, 'attachments', 50)
        && boundedList(data, 'photos', 50)
        && validLegacyInventorySourceData(data)
        && validLegacyInventoryImportMetadata(data)
        && data.qr is bool
        && nullableShortString(data, 'categoryId', 128)
        && nullableShortString(data, 'assetTypeId', 128)
        && nullableShortString(data, 'codeGroupId', 128)
        && nullableShortString(data, 'departmentId', 128)
        && nullableShortString(data, 'assignedUserId', 128)
        && (!('qrToken' in data) || (data.qrToken is string && data.qrToken.size() >= 16 && data.qrToken.size() <= 64))
        && (!('qrUpdatedAt' in data) || data.qrUpdatedAt is timestamp)
        && auditMetadataValid(data)
        && noPrivilegeFields(data);
    }

    // Historical Drive imports have a different provenance map and sometimes
    // an ISO-string createdAt. They may be edited only through the same narrow
    // business-field surface as current assets; identifiers, provenance,
    // creation metadata and privilege fields remain immutable.
    function validLegacyAssetEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','description','category','subcategory','type','brand','model',
          'serialNumber','barcode','location','currentLocationId','homeLocationId',
          'mainLocationId','currentLocationPath','currentBin','lastMovementAt',
          'department','assignedTo','responsibleEmployee','supplier','manufacturer',
          'status','condition','purchaseDate','purchasePrice','warrantyStart',
          'warrantyExpiry','dateAdded','lastUpdated','lastModifiedBy',
          'maintenanceRequired','usefulLifeEnd','technicalSpecifications',
          'remoteAccess','attachments','photos','notes','qr','qrToken','qrUpdatedAt',
          'categoryId','assetTypeId','codeGroupId','departmentId','assignedUserId',
          'updatedAt','updatedBy','isArchived','archivedAt','archivedBy',
          'deletionReason','restoredAt','restoredBy'
        ])
        && request.resource.data.code == resource.data.code
        && request.resource.data.codePrefix == resource.data.codePrefix
        && request.resource.data.codeNumber == resource.data.codeNumber
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('sourceData', null) == resource.data.get('sourceData', null)
        && request.resource.data.get('importMetadata', null) == resource.data.get('importMetadata', null)
        // Legacy assets may be incomplete. Authorized users can repair one
        // ordinary field at a time; new assets still use validAsset().
        && shortString(request.resource.data, 'name', 200)
        && shortString(request.resource.data, 'serialNumber', 200)
        && shortString(request.resource.data, 'description', 4000)
        && shortString(request.resource.data, 'notes', 4000)
        && shortString(request.resource.data, 'currentLocationPath', 500)
        && shortString(request.resource.data, 'currentBin', 200)
        && boundedList(request.resource.data, 'attachments', 50)
        && boundedList(request.resource.data, 'photos', 50)
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.size() > 0
        && request.resource.data.updatedBy.size() <= 128
        && noPrivilegeFields(request.resource.data);
    }

    function validInventory(data) {
      return data.keys().hasOnly([
          'code','barcode','name','description','itemType','category','subcategory',
          'brand','model','manufacturer','supplier','supplierItemCode','unit',
          'onHand','reserved','minimum','reorderLevel','reorderQuantity','maximum',
          'warehouse','storageRoom','shelf','rack','location','department',
          'lastPurchaseDate','unitCost','currency','batchNumber','expirationDate',
          'photograph','attachments','notes','createdBy','createdAt','modifiedBy',
          'lastUpdated','archived','archiveReason','workflowStatus','updatedAt',
          'updatedBy','isArchived','archivedAt','archivedBy',
          'sourceData','importMetadata'
        ])
        && data.keys().hasAll(['code','name','itemType','category','unit','onHand','reserved','minimum','reorderLevel','reorderQuantity','warehouse','location','createdBy','createdAt','modifiedBy','lastUpdated','archived','updatedAt','updatedBy'])
        && data.code is string && data.code.size() > 0 && data.code.size() <= 80
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.itemType is string && data.itemType.size() <= 100
        && data.category is string && data.category.size() <= 100
        && data.unit is string && data.unit.size() <= 40
        && data.onHand is number && data.onHand >= 0 && data.onHand <= 1000000000
        && data.reserved is number && data.reserved >= 0 && data.reserved <= data.onHand
        && data.minimum is number && data.minimum >= 0
        && data.reorderLevel is number && data.reorderLevel >= 0
        && data.reorderQuantity is number && data.reorderQuantity >= 0
        && (!("maximum" in data) || (data.maximum is number && data.maximum >= data.onHand))
        && data.archived is bool
        && shortString(data, 'description', 4000)
        && shortString(data, 'notes', 4000)
        && boundedList(data, 'attachments', 50)
        && validLegacyInventorySourceData(data)
        && validLegacyInventoryImportMetadata(data)
        && auditMetadataValid(data)
        && noPrivilegeFields(data);
    }

    // Code groups are unlimited: the app no longer exposes minimumNumber/
    // maximumNumber for editing (they're set to fixed, generous defaults on
    // create) — they stay required here only for backward compatibility
    // with documents written before this policy, and the ceiling is a
    // defensive sanity bound, not a real product limit.
    function validCodeGroup(data) {
      return data.keys().hasOnly(['name','prefix','minimumNumber','maximumNumber','nextAvailableNumber','isActive','sortOrder','createdAt','createdBy','updatedAt','updatedBy','isArchived','archivedAt','archivedBy','archived','deletionReason'])
        && data.keys().hasAll(['name','prefix','minimumNumber','maximumNumber','nextAvailableNumber','isActive','sortOrder','createdAt','updatedAt','updatedBy'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.prefix is string && data.prefix.matches('^[A-Z0-9]{1,16}$')
        && data.minimumNumber is int && data.minimumNumber >= 1
        && data.maximumNumber is int && data.maximumNumber >= data.minimumNumber && data.maximumNumber <= 1000000000
        && data.nextAvailableNumber is int && data.nextAvailableNumber >= data.minimumNumber && data.nextAvailableNumber <= data.maximumNumber + 1
        && data.isActive is bool && data.sortOrder is int
        && (!('archived' in data) || data.archived is bool)
        && (!('deletionReason' in data) || (data.deletionReason is string && data.deletionReason.size() <= 500))
        && auditMetadataValid(data);
    }

    function validAssetType(data) {
      return data.keys().hasOnly(['name','description','behavior','status','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasAll(['name','behavior','status','createdAt','createdBy','updatedAt','updatedBy'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && shortString(data, 'description', 500)
        && data.behavior in ['SERIALIZED','BULK','CONSUMABLE']
        && data.status in ['Active','Inactive','Archived']
        && auditMetadataValid(data);
    }

    function validActivity(data) {
      return data.keys().hasOnly(['at','user','action','event','entityType','entityId','result','detail','createdAt','createdBy','updatedAt','updatedBy'])
        && data.keys().hasAll(['at','user','action','entityType','entityId','result','detail','createdAt','createdBy','updatedAt','updatedBy'])
        && (!('event' in data) || (data.event is string && data.event.matches('^[A-Z_]{3,48}$')))
        && data.at is string && data.at.size() <= 40
        && data.user is string && data.user.size() <= 150
        && data.action is string && data.action.size() <= 100
        && data.entityType is string && data.entityType.size() <= 80
        && data.entityId is string && data.entityId.size() <= 160
        && data.result in ['Success', 'Failure']
        && data.detail is string && data.detail.size() <= 2000
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid;
    }

    function validDirectoryUser(data) {
      return data.keys().hasOnly(['name','email','role','department','status','lastLogin','photo','createdAt','createdBy','updatedAt','updatedBy','isArchived','archivedAt','archivedBy'])
        && data.keys().hasAll(['name','email','role','department','status','lastLogin','createdAt','createdBy','updatedAt','updatedBy'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.email is string && data.email.size() <= 254
        && data.role is string && data.role.size() <= 100
        && data.department is string && data.department.size() <= 100
        && data.status in ['Active', 'Inactive']
        && data.lastLogin is string && data.lastLogin.size() <= 40
        && nullableShortString(data, 'photo', 2048)
        && auditMetadataValid(data);
    }

    function validAssetHistoryEvent(data) {
      return data.keys().hasOnly([
          'assetId','assetCode','eventType','category','title','description',
          'previous','next','issue','solution','notes','sourceModule',
          'sourceRecordId','source','occurredAt','performedBy','importBatchId',
          'originalLegacyText','isLegacyImport','isManual','status','version',
          'fingerprint','createdAt','createdBy','updatedAt','updatedBy',
          'isArchived','archivedAt','archivedBy'
        ])
        && data.keys().hasAll([
          'assetId','assetCode','eventType','category','title','description',
          'sourceModule','source','occurredAt','isLegacyImport','isManual',
          'status','version','createdAt','createdBy','updatedAt','updatedBy'
        ])
        && data.assetId is string && data.assetId.size() > 0 && data.assetId.size() <= 128
        && data.assetCode is string && data.assetCode.size() > 0 && data.assetCode.size() <= 40
        && data.eventType is string && data.eventType.size() > 0 && data.eventType.size() <= 100
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.description is string && data.description.size() <= 4000
        && shortString(data, 'issue', 4000)
        && shortString(data, 'solution', 4000)
        && shortString(data, 'notes', 4000)
        && data.sourceModule is string && data.sourceModule.size() <= 100
        && nullableShortString(data, 'sourceRecordId', 160)
        && data.source in ['system','manual','legacy_import','correction']
        && data.occurredAt is string && data.occurredAt.size() <= 40
        && nullableShortString(data, 'performedBy', 150)
        && nullableShortString(data, 'importBatchId', 160)
        && nullableShortString(data, 'originalLegacyText', 4000)
        && data.isLegacyImport is bool && data.isManual is bool
        && data.status in ['Draft','Final']
        && data.version is int && data.version >= 1
        && nullableShortString(data, 'fingerprint', 128)
        && auditMetadataValid(data)
        && noPrivilegeFields(data);
    }
    function validPublicDirectoryUser(data, uid) {
      return data.keys().hasOnly(['uid','displayName','photoURL','department','jobTitle','accountType','authProvider','emailVerified','status','updatedAt','lastLoginAt'])
        && data.keys().hasAll(['uid','displayName','photoURL','department','jobTitle','accountType','authProvider','emailVerified','status','updatedAt'])
        && data.uid is string && data.uid == uid && uid == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && nullableShortString(data, 'photoURL', 2048)
        && nullableShortString(data, 'department', 100)
        && nullableShortString(data, 'jobTitle', 100)
        && data.accountType in ['school-user','demo-user']
        && data.authProvider in ['password','google','anonymous']
        && data.emailVerified is bool
        && data.status == 'active'
        && data.updatedAt is timestamp
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp);
    }
    function validPresence(data, uid) {
      return data.keys().hasOnly(['uid','online','lastSeenAt'])
        && data.keys().hasAll(['uid','online','lastSeenAt'])
        && data.uid is string && data.uid == uid && uid == request.auth.uid
        && data.online is bool
        && data.lastSeenAt is timestamp;
    }
    function validRole(data) {
      return data.keys().hasOnly(['name','description','permissions','system','createdAt','createdBy','updatedAt','updatedBy','isArchived','archivedAt','archivedBy'])
        && data.keys().hasAll(['name','description','permissions','system','createdAt','createdBy','updatedAt','updatedBy'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.description is string && data.description.size() <= 2000
        && boundedList(data, 'permissions', 100)
        && data.system is bool
        && auditMetadataValid(data);
    }
    // Owner-only safety-net for ad-hoc writes (bulk edits, data cleanup).
    // The ONLY remaining guardrail is that nobody can grant themselves
    // administrator powers via a client write; every other shape check is
    // intentionally dropped so the Owner can repair records whose fields
    // the stricter validators don't yet know about.
    function ownerSanityWrite(data) {
      return isOwner() && noPrivilegeFields(data);
    }
    function validOperationalRecord(data) {
      return data.size() <= 200
        && auditMetadataValid(data)
        && noPrivilegeFields(data)
        && shortString(data, 'name', 200)
        && shortString(data, 'title', 300)
        && shortString(data, 'description', 4000)
        && shortString(data, 'notes', 4000)
        && boundedList(data, 'attachments', 50)
        && boundedList(data, 'history', 500);
    }

    function validAccessAssignment(data, uid) {
      return data.keys().hasOnly([
          'uid','role','permissions','denials','active','allRecords',
          'departmentIds','locationIds','createdAt','createdBy','updatedAt','updatedBy'
        ])
        && data.keys().hasAll([
          'uid','role','permissions','denials','active','allRecords',
          'departmentIds','locationIds','createdAt','createdBy','updatedAt','updatedBy'
        ])
        && data.uid == uid
        && data.role is string && data.role.size() > 0 && data.role.size() <= 80
        && data.permissions is list && data.permissions.size() <= 200
        && data.denials is list && data.denials.size() <= 160
        && data.active is bool && data.allRecords is bool
        && data.departmentIds is list && data.departmentIds.size() <= 50
        && data.locationIds is list && data.locationIds.size() <= 100
        && auditMetadataValid(data);
    }

    function validQrIdentity(data) {
      return data.keys().hasOnly([
          'assetId','status','source','createdAt','createdBy',
          'revokedAt','revokedBy','replacedByToken','updatedAt','updatedBy'
        ])
        && data.keys().hasAll(['assetId','status','source'])
        && data.assetId is string && data.assetId.size() > 0 && data.assetId.size() <= 80
        && data.status in ['ACTIVE','REVOKED']
        && data.source in ['created','backfilled','rotated']
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('revokedAt' in data) || data.revokedAt is timestamp)
        && (!('revokedBy' in data) || data.revokedBy is string)
        && (!('replacedByToken' in data) || (data.replacedByToken is string && data.replacedByToken.size() >= 16 && data.replacedByToken.size() <= 64));
    }

    function canProvisionQrIdentity() {
      return hasAnyPermission(['admin.system.configure','assets.create','inventory.import']);
    }

    function canManageQrIdentity() {
      return hasAnyPermission(['admin.system.configure','assets.edit','assets.archive']);
    }

    function canReadOperationalCollection(name) {
      return (name in ['inventoryTransactions','inventoryReservations'] && hasPermission('inventory.view'))
        || (name == 'categories' && hasAnyPermission(['assets.view','inventory.view']))
        || (name == 'locations' && isAuthorizedAimsUser())
        || (name == 'locationTypes' && hasAnyPermission(['assets.view','inventory.view','locationTypes.manage']))
        || (name == 'departments' && isAuthorizedAimsUser())
        || (name == 'assignments' && hasAnyPermission(['assignments.view','assignments.manage']))
        || (name == 'borrows' && hasAnyPermission(['borrows.view','borrow.manage']))
        || (name == 'repairs' && hasAnyPermission(['repairs.view','repairs.manage']))
        || (name in ['maintenanceSchedules','maintenanceRecords'] && hasAnyPermission(['maintenance.view','maintenance.manage']))
        || (name == 'assetMovements' && hasAnyPermission(['movements.view','movements.manage']))
        || (name in ['audits','auditDiscrepancies','correctiveActions'] && hasPermission('audits.view'))
        || (name == 'disposals' && hasPermission('disposals.view'))
        || (name == 'notifications' && hasPermission('notifications.view'))
        || (name in ['reports','reportResults','scheduledReports'] && hasPermission('reports.view'));
    }

    // Keep the generic operational match cheap for collections that already
    // have dedicated rules. This also keeps validated multi-document imports
    // below Firestore's rules-expression limit.
    function isOperationalCollection(name) {
      return name in [
        'inventoryTransactions','inventoryReservations','categories','locations',
        'locationTypes','departments','assignments','borrows','repairs',
        'maintenanceSchedules','maintenanceRecords','assetMovements','audits',
        'auditDiscrepancies','correctiveActions','disposals','notifications',
        'reports','reportResults','scheduledReports'
      ];
    }

    function canWriteOperationalCollection(name) {
      return (name == 'inventoryTransactions' && hasAnyPermission(['inventory.receive','inventory.issue','inventory.transfer','inventory.return','inventory.correct']))
        || (name == 'inventoryReservations' && hasAnyPermission(['inventory.reserve','inventory.reservations.approve']))
        || (name == 'categories' && hasPermission('categories.manage'))
        || (name == 'locations' && isAuthorizedAimsUser())
        || (name == 'locationTypes' && hasPermission('locationTypes.manage'))
        || (name == 'departments' && isAuthorizedAimsUser())
        || (name == 'assignments' && hasAnyPermission(['assignments.manage','assignments.create','assignments.edit','assignments.approve','assignments.return','assignments.reassign']))
        || (name == 'borrows' && hasAnyPermission(['borrow.manage','borrows.create','borrows.edit','borrows.approve','borrows.reject','borrows.issue','borrows.return']))
        || (name == 'repairs' && hasAnyPermission(['repairs.manage','repairs.create','repairs.edit','repairs.diagnose','repairs.approve','repairs.parts','repairs.perform','repairs.test','repairs.complete','repairs.unrepairable','repairs.return']))
        || (name in ['maintenanceSchedules','maintenanceRecords'] && hasAnyPermission(['maintenance.manage','maintenance.create','maintenance.edit','maintenance.start','maintenance.complete','maintenance.skip','maintenance.reschedule','maintenance.cancel']))
        || (name == 'assetMovements' && hasAnyPermission(['movements.manage','movements.create','movements.approve','movements.complete','movements.correct']))
        || (name == 'audits' && hasAnyPermission(['audits.perform','audits.create','audits.edit','audits.generate','audits.freeze','audits.prepare','audits.start','audits.review','audits.complete','audits.close','audits.cancel']))
        || (name == 'auditDiscrepancies' && hasAnyPermission(['discrepancies.create','discrepancies.assign','discrepancies.review','discrepancies.reclassify','discrepancies.resolve','discrepancies.escalate','discrepancies.close']))
        || (name == 'correctiveActions' && hasAnyPermission(['corrective.create','corrective.assign','corrective.perform','corrective.approve','corrective.reject','corrective.verify','corrective.reopen']))
        || (name == 'disposals' && hasAnyPermission(['disposals.request','disposals.approve']))
        || (name == 'notifications' && hasAnyPermission(['notifications.preferences','notifications.defaults','notifications.escalate','notifications.resolve']))
        || (name in ['reports','reportResults'] && hasAnyPermission(['reports.generate','reports.custom.create','reports.private.save','reports.shared.publish']))
        || (name == 'scheduledReports' && hasPermission('reports.schedule'));
    }

    // Technical problem reports with auto-captured diagnostics.
    match /problemReports/{reportId} {
      allow read: if request.auth != null
        && (resource.data.reportedBy == request.auth.uid
            || hasAnyPermission(['admin.users.manage','notifications.escalate']));
      allow create: if request.auth != null
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.description is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.problemType in [
          'crash','unexpected-behavior','missing-data','permission',
          'performance','visual','other'
        ]
        && request.resource.data.diagnostics is map;
      allow update: if hasAnyPermission(['admin.users.manage','notifications.escalate']);
      allow delete: if false;
    }

    // Support tickets. Any signed-in user can open a ticket (requested
    // by themselves) and read their own tickets. Admin workflows can
    // read/update tickets via a separate permission.
    match /supportTickets/{ticketId} {
      allow read: if request.auth != null
        && (resource.data.requestedBy == request.auth.uid
            || hasAnyPermission(['admin.users.manage','notifications.escalate']));
      allow create: if request.auth != null
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.subject is string
        && request.resource.data.description is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.category in [
          'login','asset','location','repair','data','report',
          'permission','system-error','other'
        ]
        && request.resource.data.priority in ['low','normal','high','urgent'];
      allow update: if hasAnyPermission(['admin.users.manage','notifications.escalate']);
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwnUser(uid);
      allow create: if isVerified() && request.auth.uid == uid && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.firstLoginAt == request.time
        && request.resource.data.lastLoginAt == request.time;
      allow update: if isVerified() && request.auth.uid == uid && validUser(request.resource.data)
        && immutableUserCreatedAt()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','department','jobTitle','preferences','authProvider','emailVerified','updatedAt','lastLoginAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Per-user Security activity log. Clients write their own events
      // (sign-in, sign-out, password change, MFA toggles). Events are
      // append-only; nothing else may read or modify them.
      match /authEvents/{eventId} {
        allow read: if isOwnUser(uid);
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.at == request.time
          && request.resource.data.type in [
            'loggedIn','loggedOut','loginFailed',
            'passwordChanged','mfaEnabled','mfaDisabled',
            'newDevice','sessionTerminated'
          ];
        allow update, delete: if false;
      }

      // Per-user MFA backup codes. Only the user may read/write; only
      // SHA-256 hashes of codes are stored (never plaintext).
      match /mfaBackup/{docId} {
        allow read: if isOwnUser(uid);
        allow create, update: if isOwnUser(uid)
          && request.resource.data.hashes is list;
        allow delete: if isOwnUser(uid);
      }
    }

    match /accessAssignments/{uid} {
      allow read: if isOwnUser(uid) || hasPermission('admin.users.manage');
      allow create: if hasPermission('admin.users.manage')
        && validAccessAssignment(request.resource.data, uid)
        && ownerRoleAllowed(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasPermission('admin.users.manage')
        && validAccessAssignment(request.resource.data, uid)
        && ownerRoleAllowed(request.resource.data)
        && ownerRoleAllowed(resource.data)
        && immutableAuditFields()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /userDirectory/{uid} {
      allow read: if isVerified();
      allow create: if isOwnUser(uid) && validPublicDirectoryUser(request.resource.data, uid)
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwnUser(uid) && validPublicDirectoryUser(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','department','jobTitle','authProvider','emailVerified','status','updatedAt','lastLoginAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Lightweight session-presence heartbeat for the Users module's
    // Online/Offline indicator. Owner-write-only, so a user can only ever
    // misrepresent their OWN presence (no account-status/role/permission
    // bypass); every other verified user may read it, matching userDirectory.
    match /presence/{uid} {
      allow read: if isVerified();
      allow create, update: if isOwnUser(uid) && validPresence(request.resource.data, uid)
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if false;
    }

    match /assets/{id} {
      allow read: if isOwner() || hasPermission('assets.view');
      // Owner path: no shape validation, no identifier-immutability check.
      // Only guardrail is that nobody — including the Owner — can grant
      // themselves administrator powers via noPrivilegeFields.
      allow create: if ownerSanityWrite(request.resource.data)
        || validLegacyImportedAsset(request.resource.data)
        || (hasPermission('assets.create') && validAsset(request.resource.data));
      allow update: if ownerSanityWrite(request.resource.data)
        || (
          hasAnyPermission(['assets.edit','assets.archive','movements.create'])
          && ((validAsset(request.resource.data) && immutableAuditFields()) || validLegacyAssetEdit())
          && request.resource.data.code == resource.data.code
          && request.resource.data.codePrefix == resource.data.codePrefix
          && request.resource.data.codeNumber == resource.data.codeNumber
        );
      allow delete: if false;
    }
    match /qrIdentities/{token} {
      allow read: if hasPermission('assets.view');
      allow create: if canProvisionQrIdentity() && validQrIdentity(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canManageQrIdentity() && validQrIdentity(request.resource.data) && immutableAuditFields()
        && request.resource.data.assetId == resource.data.assetId
        && resource.data.status == 'ACTIVE' && request.resource.data.status == 'REVOKED'
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /inventoryItems/{id} {
      allow read: if isOwner() || hasPermission('inventory.view');
      allow create: if ownerSanityWrite(request.resource.data)
        || validLegacyImportedInventory(request.resource.data)
        || (hasPermission('inventory.create') && validInventory(request.resource.data));
      allow update: if ownerSanityWrite(request.resource.data)
        || (
          hasAnyPermission(['inventory.edit','inventory.archive','inventory.restore','inventory.receive','inventory.issue','inventory.transfer','inventory.return','inventory.reserve','inventory.correct'])
          && validInventory(request.resource.data) && immutableAuditFields()
          && request.resource.data.code == resource.data.code
        );
      allow delete: if false;
    }
    match /codeGroups/{id} {
      allow read: if isOwner() || isAuthorizedAimsUser();
      allow create: if ownerSanityWrite(request.resource.data)
        || (isAuthorizedAimsUser() && validCodeGroup(request.resource.data));
      // Browser clients may change descriptive fields, never the prefix.
      // Prefix migrations are performed only by the trusted backend Function.
      allow update: if (
          ownerSanityWrite(request.resource.data)
          && request.resource.data.prefix == resource.data.prefix
        ) || (
          isAuthorizedAimsUser()
          && validCodeGroup(request.resource.data)
          && immutableAuditFields()
          && request.resource.data.prefix == resource.data.prefix
          && (request.resource.data.get('archived', false) != true
              || resource.data.get('archived', false) == true)
        );
      allow delete: if false;
    }
    // Asset Types (tracking behavior). The document id is the normalised slug
    // of the name, so the id itself enforces name uniqueness. The behavior and
    // name are immutable once created; types are archived, never deleted.
    // They remain readable as reference data in asset forms, but managing the
    // Tracking Types module is strictly Owner-only.
    match /assetTypes/{id} {
      allow read: if isAuthorizedAimsUser();
      allow create: if isOwner()
        && id.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && id.size() <= 64
        && validAssetType(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner()
        && validAssetType(request.resource.data)
        && immutableAuditFields()
        && request.resource.data.behavior == resource.data.behavior
        && request.resource.data.name == resource.data.name
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /assetCodes/{code} {
      allow read: if hasAnyPermission(['assets.view','assets.create']);
      allow create: if hasPermission('assets.create')
        && request.resource.data.keys().hasOnly(['code','codeGroupId','reservedBy','createdAt'])
        && request.resource.data.code == code
        && code.size() <= 40
        && request.resource.data.codeGroupId is string
        && request.resource.data.codeGroupId.size() <= 128
        && request.resource.data.reservedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/codeGroups/$(request.resource.data.codeGroupId));
      allow update, delete: if false;
    }
    match /activityLogs/{id} {
      allow read: if hasAnyPermission(['admin.audit.read','activity.view']);
      allow create: if isVerified() && validActivity(request.resource.data);
      allow update, delete: if false;
    }
    match /assetHistoryEvents/{id} {
      allow read: if isOwner() || hasAnyPermission(['history.view','assets.view']);
      allow create: if ownerSanityWrite(request.resource.data) || validLegacyInventoryHistory(request.resource.data) || (validAssetHistoryEvent(request.resource.data) && (
        (request.resource.data.isManual == true && hasPermission('history.create_manual'))
        || (request.resource.data.isManual == false && hasAnyPermission([
          'assets.create','assets.edit','assets.archive','assignments.manage',
          'assignments.create','assignments.return','borrow.manage','borrows.create',
          'borrows.approve','borrows.return','repairs.manage','repairs.create',
          'repairs.complete','maintenance.manage','maintenance.create',
          'maintenance.complete','movements.manage','movements.create',
          'audits.perform','disposals.request','disposals.approve'
        ]))
      ));
      allow update: if validAssetHistoryEvent(request.resource.data)
        && resource.data.isManual == true && request.resource.data.isManual == true
        && resource.data.status == 'Draft'
        && hasPermission('history.edit_manual')
        && immutableAuditFields()
        && request.resource.data.assetId == resource.data.assetId
        && request.resource.data.assetCode == resource.data.assetCode
        && request.resource.data.source == resource.data.source;
      allow delete: if resource.data.isManual == true
        && resource.data.status == 'Draft'
        && hasPermission('history.delete_manual');
    }
    match /migrationAudits/{id} {
      allow read: if hasPermission('admin.audit.read');
      allow create: if hasPermission('admin.system.configure')
        && request.resource.data.importBatchId == id
        && request.resource.data.fileFingerprint is string
        && request.resource.data.parserSchemaVersion is int
        && request.resource.data.actor is string
        && request.resource.data.writeCount is int;
      allow update, delete: if false;
    }

    match /directoryUsers/{id} {
      allow read: if hasPermission('admin.users.manage');
      allow create: if hasPermission('admin.users.manage') && validDirectoryUser(request.resource.data);
      allow update: if hasPermission('admin.users.manage') && validDirectoryUser(request.resource.data) && immutableAuditFields();
      allow delete: if false;
    }
    // Master Data references (ReferenceData page) are persisted to the
    // dedicated `categories`, `locations` and `departments` collections above.
    // There is no separate `references` collection, so no rule is opened for it.
    match /roles/{id} {
      allow read: if hasAnyPermission(['roles.manage','admin.roles.manage']);
      allow create: if hasPermission('admin.roles.manage') && validRole(request.resource.data);
      allow update: if hasPermission('admin.roles.manage') && validRole(request.resource.data) && immutableAuditFields()
        && request.resource.data.system == resource.data.system;
      allow delete: if false;
    }
    match /systemSettings/{id} {
      allow read: if isVerified();
      allow create, update: if hasPermission('admin.system.configure') && validOperationalRecord(request.resource.data);
      allow delete: if false;
    }

    // =======================================================================
    // DEVICE INFORMATION: authorized-user reads, owner-only mutations.
    // =======================================================================
    match /deviceManagement/{document=**} {
      allow read: if isAuthorizedAimsUser();
      allow write: if isOwner();
    }
    match /deviceCommands/{document=**} {
      allow read, write: if isOwner();
    }
    match /devicePolicies/{document=**} {
      allow read, write: if isOwner();
    }
    match /deviceNetwork/{document=**} {
      allow read: if isAuthorizedAimsUser();
      allow write: if false;
    }
    match /deviceCompliance/{document=**} {
      allow read: if isAuthorizedAimsUser();
      allow write: if isOwner();
    }
    match /deviceAuditTrail/{document=**} {
      // Audit records must not be normally deleted.
      allow read, create: if isOwner();
      allow update, delete: if false;
    }
    // Network Discovery is administered by the single verified AIMS Owner.
    // Agent writes use Admin SDK Cloud Functions after credential and scope checks.
    match /discoveryAgents/{document=**} { allow read: if isOwner(); allow write: if false; }
    match /discoveryEnrollments/{document=**} { allow read, write: if false; }
    match /discoveryRequests/{document=**} { allow read: if isOwner(); allow write: if false; }
    match /discoveredDevices/{document=**} { allow read: if isOwner(); allow write: if false; }
    // =======================================================================

    match /legalDocuments/{type} {
      allow read: if resource.data.status == 'published' || hasPermission('legal.read');
      allow create, update: if hasPermission('legal.manage') && validOperationalRecord(request.resource.data);
      allow delete: if false;
      match /versions/{version} {
        allow read: if resource.data.status in ['published', 'archived'] || hasPermission('legal.audit');
        allow create: if hasPermission('legal.publish') && validOperationalRecord(request.resource.data);
        allow update, delete: if false;
      }
    }
    match /legalConfiguration/{id} {
      allow read: if true;
      allow create, update: if hasPermission('legal.publish') && request.resource.data.size() <= 100;
      allow delete: if false;
    }
    match /policyAcknowledgements/{id} {
      allow read: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid
        && request.resource.data.size() <= 20;
      allow update, delete: if false;
    }

    // Stock-movement transaction records are immutable: once written, their
    // substance (source, destination, quantity, type, id, date, who) can never
    // change. Only a later approval / completion stamp may be appended.
    match /assetMovements/{id} {
      allow read: if hasAnyPermission(['movements.view','movements.manage']);
      allow create: if hasAnyPermission(['movements.manage','movements.create','movements.approve','movements.complete','movements.correct'])
        && validOperationalRecord(request.resource.data);
      allow update: if hasAnyPermission(['movements.approve','movements.complete','movements.manage'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['approvedBy','status','completedAt','updatedAt','updatedBy']);
      allow delete: if false;
    }

    match /{collectionName}/{id} {
      allow read: if isOperationalCollection(collectionName)
        && (isOwner() || canReadOperationalCollection(collectionName));
      allow create: if isOperationalCollection(collectionName)
        && (
          ownerSanityWrite(request.resource.data)
          || (canWriteOperationalCollection(collectionName) && validOperationalRecord(request.resource.data))
        );
      allow update: if isOperationalCollection(collectionName)
        && collectionName != 'inventoryTransactions'
        && collectionName != 'assetMovements'
        && (
          ownerSanityWrite(request.resource.data)
          || (
            canWriteOperationalCollection(collectionName)
            && validOperationalRecord(request.resource.data) && immutableAuditFields()
          )
        )
        // Archiving a Hoofdlocatie (recycle bin) is a Master Data deletion:
        // Function only.
        && !(collectionName == 'locations'
             && resource.data.get('type', '') == 'Main location'
             && request.resource.data.get('status', '') == 'Archived'
             && resource.data.get('status', '') != 'Archived');
      // Master Data deletion is performed only by the trusted Cloud Function,
      // after dependency checks and delete-manager authorization.
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}





