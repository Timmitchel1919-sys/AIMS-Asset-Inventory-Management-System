# Firebase web app configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AIMS policy is restricted to this exact domain. Keep this value synchronized
# with the authoritative helper and Firestore rules.
VITE_ALLOWED_EMAIL_DOMAINS=kangoeroeschool.com
VITE_SELF_REGISTRATION_ENABLED=true

# Temporary demo authentication. Production must use false/true respectively.
VITE_DEMO_AUTH_MODE=false
